# Panel master systemd unit (production Linux deploy).
[Unit]
Description=Panel master
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=panel
Group=panel
ExecStart=/usr/local/bin/panel-master -addr :8080 -data /var/lib/panel
Restart=on-failure
RestartSec=3
# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/panel
PrivateTmp=true

[Install]
WantedBy=multi-user.target
