# Panel master systemd unit (production Linux deploy).
[Unit]
Description=Panel master
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=panel
Group=panel
ExecStart=/opt/panel/bin/panel-master -addr :8080 -data /opt/panel/master-data
Restart=on-failure
RestartSec=3
# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/panel/master-data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
