# Panel agent systemd unit (production Linux deploy).
[Unit]
Description=Panel agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=panel
Group=panel
ExecStart=/opt/panel/bin/panel-agent -config /opt/panel/agent.json
Restart=on-failure
RestartSec=3
StartLimitIntervalSec=120
StartLimitBurst=5
# Hardening: agent executes instance commands, so confine writes.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/panel
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
